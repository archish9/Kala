{
  "id": "soft-clinical",
  "axes": { "formality": [0.5, 0.8], "density": [0.3, 0.6], "energy": [0.0, 0.3], "expressiveness": [0.1, 0.4] },
  "fitFor": ["health", "medical", "clinic", "patient", "insurance", "care", "therapy"],
  "avoidFor": ["gaming", "nightlife", "crypto"],
  "type": {
    "families": { "sans": "Figtree", "serif": "Source Serif 4" },
    "fallbacks": { "sans": ["system-ui", "sans-serif"] },
    "ratio": 1.25, "baseSize": 16, "maxWeights": 2
  },
  "space": { "base": 4, "rhythm": "normal", "sectionGap": 80 },
  "shape": { "radius": 10, "depth": "borders" },
  "color": { "strategy": "cool calm neutral with a reassuring blue-green accent", "neutralHue": 200, "chromaCeiling": 0.04 },
  "motion": { "budget": "minimal", "duration": 160, "easing": "ease-out" },
  "signature": [
    "Never use red for anything except genuine danger.",
    "Every number carries its unit, spelled out.",
    "Forms ask one question per screen where the stakes are high.",
    "Reassurance sits next to the action, not in a tooltip."
