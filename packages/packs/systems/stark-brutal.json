{
  "id": "stark-brutal",
  "axes": { "formality": [0.3, 0.7], "density": [0.3, 0.6], "energy": [0.7, 1.0], "expressiveness": [0.8, 1.0] },
  "fitFor": ["studio", "experimental", "music", "event", "fashion", "art", "manifesto"],
  "avoidFor": ["medical", "compliance", "banking", "enterprise"],
  "type": {
    "families": { "sans": "Space Grotesk", "serif": "Instrument Serif" },
    "fallbacks": { "sans": ["system-ui", "sans-serif"] },
    "ratio": 1.5, "baseSize": 16, "maxWeights": 2
  },
  "space": { "base": 4, "rhythm": "normal", "sectionGap": 96 },
  "shape": { "radius": 0, "depth": "borders" },
  "color": { "strategy": "flat near-black and paper with one unmixed accent", "neutralHue": 0, "chromaCeiling": 0.02 },
  "motion": { "budget": "moderate", "duration": 80, "easing": "steps(4, end)" },
  "signature": [
    "Type is enormous or it is small; nothing sits in between.",
    "Borders are 2px and black. There are no shadows anywhere.",
    "Layout is asymmetric on purpose and holds its grid.",
    "Hover states invert rather than fade."
  ],
  "antiDefaults": ["drop-shadows", "rounded-corners", "gradient-anything"]
}
