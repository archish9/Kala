{
  "id": "archive-serif",
  "axes": { "formality": [0.6, 0.9], "density": [0.2, 0.5], "energy": [0.0, 0.3], "expressiveness": [0.5, 0.8] },
  "fitFor": ["archive", "library", "museum", "research", "academic", "journal", "reference"],
  "avoidFor": ["startup", "gaming", "ecommerce"],
  "type": {
    "families": { "sans": "Libre Franklin", "serif": "Libre Baskerville" },
    "fallbacks": { "sans": ["system-ui", "sans-serif"] },
    "ratio": 1.333, "baseSize": 18, "maxWeights": 2
  },
  "space": { "base": 4, "rhythm": "generous", "sectionGap": 120 },
  "shape": { "radius": 0, "depth": "borders" },
  "color": { "strategy": "aged paper neutral with an ink-blue accent", "neutralHue": 35, "chromaCeiling": 0.03 },
  "motion": { "budget": "minimal", "duration": 180, "easing": "cubic-bezier(0.32, 0.72, 0, 1)" },
  "signature": [
    "Body copy is serif and set at a comfortable reading size.",
    "Citations and metadata sit in the sans, one step down.",
    "Navigation is a table of contents, not a toolbar.",
    "Dates are written in full, never relative."
  ],
  "antiDefaults": ["infinite-scroll", "card-grid-everything", "drop-shadows"]
}
